# ──────────────────────────────────────────────
# AI-Native Boilerplate — Environment Variables
# Copy to .env.local and fill in values.
# NEVER commit .env or .env.local to git.
# ──────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_NAME="[App Name]"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Auth (better-auth) ────────────────────────
# Generate: openssl rand -hex 32
AUTH_SECRET=""

# ── Database (Cloudflare D1) ──────────────────
# For local dev: use wrangler D1
DATABASE_URL=""          # local SQLite path or wrangler binding

# ── Stripe ───────────────────────────────────
STRIPE_SECRET_KEY=""              # sk_test_... (never sk_live_ in dev)
STRIPE_PUBLISHABLE_KEY=""         # pk_test_...
STRIPE_WEBHOOK_SECRET=""          # whsec_... (from Stripe Dashboard)

# Plan Price IDs — copy from Stripe Dashboard
STRIPE_PRICE_PRO_MONTHLY=""       # price_...
STRIPE_PRICE_PRO_ANNUAL=""        # price_...
STRIPE_PRICE_TEAM_MONTHLY=""      # price_...
STRIPE_PRICE_TEAM_ANNUAL=""       # price_...

# ── Email ─────────────────────────────────────
EMAIL_FROM="noreply@[domain]"
RESEND_API_KEY=""                  # re_... (or your email provider key)

# ── Storage (Cloudflare R2) ───────────────────
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── Error Tracking ────────────────────────────
SENTRY_DSN=""                      # or your error tracker

# ── Analytics (optional) ─────────────────────
# POSTHOG_API_KEY=""

# ── OAuth Providers (optional) ───────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ── Desktop Agent (Tauri variant only) ────────
# TAURI_SIGNING_PRIVATE_KEY=""     # For update bundle signing
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
# RELEASES_API_URL="https://[domain]/api/releases"
