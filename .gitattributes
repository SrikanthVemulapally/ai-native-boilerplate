# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Shell scripts must keep LF
*.sh text eol=lf
*.bash text eol=lf

# Windows-specific files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
