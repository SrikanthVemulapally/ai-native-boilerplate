#!/usr/bin/env bash
# .githooks/pre-commit
# Runs before every commit. Blocks if any check fails.
# Install: git config core.hooksPath .githooks

set -e

echo "🔍 Pre-commit checks running..."

# ── 1. SECRET DETECTION ──────────────────────────────────────────────────────
echo "  Checking for secrets..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check for common secret patterns
SECRET_PATTERNS=(
  'sk_live_[a-zA-Z0-9]+'    # Stripe live secret
  'rk_live_[a-zA-Z0-9]+'    # Stripe restricted live key
  'AIza[0-9A-Za-z_-]{35}'   # Google API key
  'AKIA[0-9A-Z]{16}'         # AWS Access Key
  'ghp_[a-zA-Z0-9]{36}'     # GitHub personal token
  'xoxb-[0-9]+'              # Slack bot token
  'password\s*=\s*["\'][^"\']+["\']'  # Hardcoded password
)

for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if git diff --cached "$file" | grep -qE "$pattern" 2>/dev/null; then
        echo "  ❌ BLOCKED: Possible secret detected in $file (pattern: $pattern)"
        echo "     Remove the secret and use environment variables instead."
        exit 1
      fi
    done
  fi
done

# Block .env files from being committed
for file in $STAGED_FILES; do
  case "$file" in
    .env|.env.local|.env.production|.env.staging)
      echo "  ❌ BLOCKED: Attempting to commit $file"
      echo "     Environment files must never be committed."
      exit 1
      ;;
  esac
done

echo "  ✅ No secrets detected"

# ── 2. DEBUG CODE CHECK ───────────────────────────────────────────────────────
echo "  Checking for debug code..."

DEBUG_PATTERNS=(
  'console\.log('
  'console\.debug('
  'debugger;'
  'TODO: remove'
  'FIXME: remove'
)

for file in $STAGED_FILES; do
  if [[ "$file" =~ \.(ts|tsx|js|jsx)$ ]] && [ -f "$file" ]; then
    for pattern in "${DEBUG_PATTERNS[@]}"; do
      if git diff --cached "$file" | grep -qE "^\+.*$pattern" 2>/dev/null; then
        echo "  ⚠️  Warning: debug code found in $file ('$pattern')"
        echo "     Consider removing before committing."
        # Warning only — not blocking. Change exit 0 to exit 1 to block.
      fi
    done
  fi
done

echo "  ✅ Debug check complete"

# ── 2b. CONVENTION CHECKS ────────────────────────────────────────────────────
echo "  Checking conventions..."

for file in $STAGED_FILES; do
  if [[ "$file" =~ \.(ts|tsx)$ ]] && [ -f "$file" ]; then
    # Block explicit 'any' type annotations (not 'unknown' which is allowed)
    if git diff --cached "$file" | grep -qE '^\+.*:\s*any\b' 2>/dev/null; then
      echo "  ⚠️  Warning: 'any' type found in $file — use 'unknown' or a proper type"
    fi
    # Block catch-all error swallowing
    if git diff --cached "$file" | grep -qE '^\+.*catch\s*\([^)]*\)\s*\{\s*\}' 2>/dev/null; then
      echo "  ❌ BLOCKED: Empty catch block in $file — at minimum, log the error"
      exit 1
    fi
  fi
done

echo "  ✅ Convention check complete"

# ── 3. LINT ───────────────────────────────────────────────────────────────────
echo "  Running lint..."

if command -v pnpm &>/dev/null; then
  if ! pnpm lint --quiet 2>/dev/null; then
    echo "  ❌ Lint failed. Run 'pnpm lint' to see errors."
    exit 1
  fi
fi

echo "  ✅ Lint passed"

# ── 4. TYPE CHECK ─────────────────────────────────────────────────────────────
echo "  Running type check..."

if command -v pnpm &>/dev/null; then
  if ! pnpm typecheck 2>/dev/null; then
    echo "  ❌ Type check failed. Run 'pnpm typecheck' to see errors."
    exit 1
  fi
fi

echo "  ✅ Type check passed"

echo "✅ All pre-commit checks passed."
exit 0
