{
  "_description": "Desktop agent (Tauri) + Web admin. Like Pulse. Auto-update is mandatory.",
  "_use_when": "Building a local desktop/system agent with a web-based admin dashboard.",
  "stack": {
    "frontend": "tanstack-start",
    "backend": "cloudflare-workers",
    "database": "cloudflare-d1",
    "storage": "cloudflare-r2",
    "orm": "drizzle",
    "styling": "tailwindcss",
    "testing": "vitest"
  },
  "features": {
    "payments": true,
    "auth": true,
    "seo": false,
    "i18n": false,
    "analytics": true,
    "auto-update": true,
    "ai": false,
    "realtime": true,
    "email": true,
    "file-uploads": false,
    "designSystem": true
  },
  "designSystem": {
    "headingFont": "inter",
    "bodyFont": "inter",
    "monoFont": "jetbrains-mono",
    "baseColor": "neutral",
    "darkMode": "system"
  },
  "variants": {
    "agent": {
      "enabled": true,
      "framework": "tauri",
      "auto-update": {
        "provider": "github-releases",
        "channel": "stable",
        "signature": true
      }
    },
    "admin": { "enabled": true, "path": "/admin" },
    "api":   { "enabled": true, "versioning": true, "openapi": true }
  },
  "_enforced": {
    "auto-update": "MANDATORY — agent variant MUST implement auto-update. Claude will refuse to scaffold agent code without it."
  }
}
