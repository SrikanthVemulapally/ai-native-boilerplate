{
  "_description": "Web-only SaaS. TanStack Start + Cloudflare Workers/D1/R2. No desktop agent.",
  "_use_when": "Building a web app or SaaS with no local desktop component.",
  "stack": {
    "frontend": "tanstack-start",
    "backend": "cloudflare-workers",
    "database": "cloudflare-d1",
    "storage": "cloudflare-r2",
    "orm": "drizzle",
    "styling": "tailwindcss",
    "testing": "vitest"
  },
  "features": {
    "payments": true,
    "auth": true,
    "seo": true,
    "i18n": false,
    "analytics": false,
    "auto-update": false,
    "ai": false,
    "realtime": false,
    "email": true,
    "file-uploads": false,
    "designSystem": true
  },
  "designSystem": {
    "headingFont": "inter",
    "bodyFont": "inter",
    "monoFont": "jetbrains-mono",
    "baseColor": "neutral",
    "darkMode": "system"
  },
  "variants": {
    "agent": { "enabled": false },
    "admin": { "enabled": false },
    "api":   { "enabled": true, "versioning": true, "openapi": true }
  }
}
